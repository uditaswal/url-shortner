<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head", { title: page.title }) %>
</head>

<body>
    <%- include("partials/header") %>

    <main class="app-main legal-main" id="main-content">
        <article class="legal-container">
            <header class="legal-heading">
                <h1><%= page.title %></h1>
                <p><%= page.summary %></p>
                <span>Last updated <%= page.lastUpdated %></span>
            </header>

            <nav class="legal-nav" aria-label="Legal and safety pages">
                <a href="/ui/privacy" <%= locals.currentPath === "/ui/privacy" ? 'aria-current="page"' : '' %>>Privacy</a>
                <a href="/ui/terms" <%= locals.currentPath === "/ui/terms" ? 'aria-current="page"' : '' %>>Terms</a>
                <a href="/ui/acceptable-use" <%= locals.currentPath === "/ui/acceptable-use" ? 'aria-current="page"' : '' %>>Acceptable use</a>
                <a href="/ui/report-abuse" <%= locals.currentPath === "/ui/report-abuse" ? 'aria-current="page"' : '' %>>Report abuse</a>
            </nav>

            <div class="legal-content">
                <% page.sections.forEach((section) => { %>
                    <section class="legal-section">
                        <h2><%= section.heading %></h2>
                        <% section.paragraphs.forEach((paragraph) => { %>
                            <p><%= paragraph %></p>
                        <% }) %>
                        <% if (section.items) { %>
                            <ul>
                                <% section.items.forEach((item) => { %>
                                    <li><%= item %></li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </section>
                <% }) %>
            </div>

            <% if (page.primaryAction) { %>
                <div class="legal-actions">
                    <a class="primary-link" href="<%= page.primaryAction.href %>" target="_blank" rel="noopener noreferrer"><%= page.primaryAction.label %></a>
                    <a class="secondary-action" href="https://www.linkedin.com/in/uditaswal/" target="_blank" rel="noopener noreferrer">Contact us</a>
                </div>
            <% } %>
        </article>
    </main>

    <%- include("partials/footer") %>
</body>

</html>
