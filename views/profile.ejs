<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head", { title: "Link analytics" }) %>
</head>

<body>
    <%- include("partials/header") %>

    <main class="app-main" id="main-content">
        <div class="container">
            <div class="page-heading">
                <h1>Analytics</h1>
                <p>Human visits across all your short links. Automated traffic is excluded.</p>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Links created</div>
                    <div class="stat-value"><%= stats.totalUrls %></div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Human visits</div>
                    <div class="stat-value"><%= stats.totalClicks %></div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Active links</div>
                    <div class="stat-value"><%= stats.activeUrls %></div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Bots excluded</div>
                    <div class="stat-value"><%= stats.botFilteredClicks %></div>
                </div>
            </div>

            <section class="data-section">
                <div class="section-heading">
                    <div>
                        <h2>Visits by country</h2>
                        <p>Location appears when the hosting provider supplies it.</p>
                    </div>
                </div>
                <% if (locals.countryStats && locals.countryStats.length > 0) { %>
                    <div class="table-wrap">
                        <table class="dashboard-table dashboard-table-compact">
                            <thead>
                                <tr>
                                    <th>Country</th>
                                    <th>Clicks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% locals.countryStats.forEach((item) => { %>
                                    <tr>
                                        <td><%= item.country %></td>
                                        <td class="numeric-cell"><%= item.clicks %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="empty">No location data yet.</p>
                <% } %>
            </section>

            <% if (locals.user?.isAdmin) { %>
                <section class="data-section">
                    <h2>Admin moderation</h2>
                    <% if (locals.flaggedUrls && locals.flaggedUrls.length > 0) { %>
                        <div class="table-wrap">
                            <table class="dashboard-table">
                                <thead>
                                    <tr>
                                        <th>Short link</th>
                                        <th>Destination</th>
                                        <th>Status</th>
                                        <th>Reason</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% locals.flaggedUrls.forEach((item) => { %>
                                        <tr>
                                            <td>/<%= item.shortId %></td>
                                            <td class="ellipsis-cell"><a href="<%= item.redirectUrl %>" target="_blank" rel="noopener noreferrer"><%= item.redirectUrl %></a></td>
                                            <td><span class="status-badge status-<%= item.statusLabel %>"><%= item.statusLabel %></span></td>
                                            <td><%= item.disabledReason || "—" %></td>
                                            <td>
                                                <form class="moderation-form" method="POST" action="/ui/admin/urls/<%= item.shortId %>/moderation">
                                                    <input type="hidden" name="action" value="<%= item.isDisabled ? 'enable' : 'disable' %>">
                                                    <input type="text" name="disabledReason" placeholder="Moderation reason" aria-label="Moderation reason for <%= item.shortId %>">
                                                    <button type="submit"><%= item.isDisabled ? "Enable" : "Disable" %></button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <p class="empty">No expired or disabled URLs need moderation right now.</p>
                    <% } %>
                </section>
            <% } %>
        </div>
    </main>

    <%- include("partials/footer") %>
</body>

</html>
