<a class="skip-link" href="#main-content">Skip to content</a>
<header class="app-header">
    <nav class="app-nav desktop-nav">
        <a href="/ui" class="brand">
            <img src="/images/url-shortener-logo.png" alt="" class="brand-logo" width="36" height="18">
            <span>URL Shortener</span>
        </a>
        <% if (locals.user) { %>
            <div class="header-user-area">
                <a href="/ui" class="nav-link" <%- ["/", "/ui"].includes(locals.currentPath) ? 'aria-current="page"' : '' %>>Links</a>
                <a href="/ui/profile" class="nav-link" <%- ["/profile", "/ui/profile"].includes(locals.currentPath) ? 'aria-current="page"' : '' %>>Analytics</a>
                <span class="user-chip" title="Signed in as <%= locals.user.name %>">@<%= locals.user.username %></span>
                <form action="/ui/auth/logout" method="POST" class="logout-form">
                    <button type="submit" class="logout-btn">Sign out</button>
                </form>
            </div>
        <% } else { %>
            <div class="nav-links">
                <a href="/ui/login" class="nav-signin">Sign in</a>
                <a href="/ui/signup" class="nav-signup">Create account</a>
            </div>
        <% } %>
    </nav>

    <nav class="app-nav mobile-nav" aria-label="Mobile navigation">
        <a href="/ui" class="brand">
            <img src="/images/url-shortener-logo.png" alt="" class="brand-logo" width="36" height="18">
            <span>URL Shortener</span>
        </a>
        <div class="mobile-nav-actions">
            <details class="mobile-menu">
                <summary aria-label="Open menu">
                    <span class="mobile-menu-dots" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </summary>
                <div class="mobile-menu-panel">
                    <% if (locals.user) { %>
                        <span class="mobile-menu-user">@<%= locals.user.username %></span>
                        <a href="/ui" <%- ["/", "/ui"].includes(locals.currentPath) ? 'aria-current="page"' : '' %>>Links</a>
                        <a href="/ui/profile" <%- ["/profile", "/ui/profile"].includes(locals.currentPath) ? 'aria-current="page"' : '' %>>Analytics</a>
                        <form action="/ui/auth/logout" method="POST" class="mobile-menu-form">
                            <button type="submit" class="mobile-menu-button danger-text">Sign out</button>
                        </form>
                    <% } else { %>
                        <a href="/ui/login">Sign in</a>
                        <a href="/ui/signup">Create account</a>
                    <% } %>
                </div>
            </details>
        </div>
    </nav>
</header>

<script nonce="<%= cspNonce %>">
    document.addEventListener("click", (event) => {
        document.querySelectorAll("details.mobile-menu[open]").forEach((menu) => {
            if (!menu.contains(event.target)) {
                menu.removeAttribute("open");
            }
        });
    });
</script>
