<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head", { title: "Sign in" }) %>
</head>

<body>
    <%- include("partials/header") %>

    <main class="app-main auth-main" id="main-content">
        <div class="narrow-container">
            <div class="page-heading">
                <h1>Welcome back</h1>
                <p>Sign in to manage your links and view analytics.</p>
            </div>

            <section class="auth-panel" aria-label="Sign in form">
                <% if (locals.error) { %>
                    <div class="form-error" role="alert"><%= locals.error %></div>
                <% } %>

                <form action="/ui/auth/login" method="POST">
                    <div class="form-group">
                        <label for="loginUsername">Username</label>
                        <input type="text" name="username" id="loginUsername" placeholder="john_doe" value="<%= locals.values?.username || '' %>" pattern="^[a-z0-9_]{3,20}$" title="Use 3 to 20 lowercase letters, numbers, or underscores" autocomplete="username" spellcheck="false" required>
                    </div>

                    <div class="form-group">
                        <label for="loginPassword">Password</label>
                        <div class="password-field">
                            <input type="password" name="password" id="loginPassword" placeholder="Enter your password" autocomplete="current-password" required>
                            <button type="button" class="password-toggle" data-password-target="loginPassword" aria-label="Show password">Show</button>
                        </div>
                    </div>

                    <button class="full-button" type="submit">Sign in</button>
                </form>
            </section>

            <p class="auth-footer">
                New here? <a href="/ui/signup">Create an account</a>
            </p>
        </div>
    </main>

    <%- include("partials/footer") %>

</body>

</html>
